REMOTEX_CONTROL_DOMAIN=control.example.com
REMOTEX_RELAY_DOMAIN=relay.example.com
REMOTEX_RELAY_PORT=7443
REMOTEX_ACME_EMAIL=admin@example.com
REMOTEX_IMAGE_TAG=local
REMOTEX_LOG=info

# Override these paths only when secrets live outside deploy/secrets.
# REMOTEX_POSTGRES_PASSWORD_FILE=/secure/path/postgres-password
# REMOTEX_DATABASE_URL_FILE=/secure/path/database-url
# REMOTEX_CONTROL_MASTER_KEY_FILE=/secure/path/control-master-key
# REMOTEX_RELAY_CERT_FILE=/secure/path/relay-cert.pem
# REMOTEX_RELAY_KEY_FILE=/secure/path/relay-key.pem
