# Copy to /etc/remotex/agent.env, set mode 0600, and review every permission.
REMOTEX_CONTROL_URL=https://control.example.com
REMOTEX_RELAY_ADDRESS=relay.example.com:7443
REMOTEX_RELAY_SERVER_NAME=relay.example.com
REMOTEX_CA_CERT=/etc/remotex/ca.pem
REMOTEX_DEVICE_NAME=linux-server
REMOTEX_IDENTITY_PATH=/var/lib/remotex/identity.key
REMOTEX_FILE_ROOTS=Data=/srv/remotex

# A system service has no interactive console, so it rejects sessions unless
# unattended access is explicitly enabled with a strong secret.
REMOTEX_UNATTENDED=false
# REMOTEX_UNATTENDED_SECRET=replace-with-at-least-12-characters
